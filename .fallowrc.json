{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/main.ts",
    "src/styles/index.css",
    "scripts/*.mjs",
    "esbuild.config.mjs",
    "version-bump.mjs"
  ],
  "typeAware": {
    "enabled": true
  },
  "usedClassMembers": [
    {
      "extends": "FuzzySuggestModal",
      "members": [
        "getItems",
        "getItemText",
        "onChooseItem"
      ]
    },
    {
      "extends": "PluginSettingTab",
      "members": [
        "display",
        "hide",
        "getSettingDefinitions"
      ]
    },
    {
      "extends": "ItemView",
      "members": [
        "getViewType",
        "getDisplayText",
        "getIcon",
        "onOpen",
        "onClose"
      ]
    },
    {
      "extends": "Modal",
      "members": [
        "onOpen",
        "onClose"
      ]
    }
  ],
  "duplicates": {
    "minOccurrences": 2
  },
  "health": {
    "coverage": "coverage/coverage-final.json",
    "thresholdOverrides": [
      {
        "files": [
          "scripts/**"
        ],
        "maxCrap": 60,
        "reason": "Obsidian CLI scripts need a live app; no unit coverage possible"
      }
    ]
  },
  "audit": {
    "gate": "new-only"
  },
  "rules": {
    "css-dead-surface": "off"
  }
}
