{
	"name": "obsidian-hoard",
	"version": "0.2.0",
	"description": "Hoard plugin for Obsidian",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/npm-proxy.mjs",
		"dev": "node esbuild.config.mjs",
		"build": "tsc && node esbuild.config.mjs build",
		"typecheck": "tsc",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"quality": "fallow",
		"quality:audit": "fallow audit",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm quality",
		"lint": "node scripts/lint-wrapper.mjs",
		"lint:bot": "node test/lint/bot-lint.mjs",
		"lint:fix": "node scripts/lint-wrapper.mjs --fix",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"vault:link": "node scripts/vault-link.mjs",
		"vault:link-test": "node scripts/vault-link.mjs --test",
		"vault:open": "node scripts/vault-open.mjs",
		"vault:reset": "node scripts/vault-reset.mjs",
		"vault:theme": "node scripts/vault-theme.mjs",
		"reload": "node scripts/reload.mjs",
		"smoke": "node test/e2e/smoke.mjs",
		"mobile:smoke": "node scripts/mobile-smoke.mjs",
		"visual:shots": "node test/visual/shots.mjs",
		"visual:diff": "node test/visual/diff.mjs"
	},
	"author": "Alexander Pape",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@eslint/json": "^0.14.0",
		"@types/node": "^16.11.6",
		"@types/pngjs": "^6.0.5",
		"@typescript-eslint/parser": "^8.50.1",
		"@vitest/coverage-istanbul": "5.0.3",
		"esbuild": "0.25.5",
		"eslint": "^9.39.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"fallow": "3.33.1",
		"globals": "14.0.0",
		"happy-dom": "^20.14.5",
		"obsidian": "1.13.0",
		"pixelmatch": "^8.0.0",
		"pngjs": "^7.0.0",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.50.1",
		"vitest": "^5.0.3",
		"yaml": "^2.9.1"
	},
	"packageManager": "pnpm@10.20.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Macavity/obsidian-hoard.git"
	},
	"bugs": {
		"url": "https://github.com/Macavity/obsidian-hoard/issues"
	},
	"homepage": "https://github.com/Macavity/obsidian-hoard#readme",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"fuse.js": "^7.3.0"
	}
}
